---
import type { Lang } from '../locales';
import { t } from '../locales';
import { farmContact } from '../data/contact';
import { cloudinary, OG_IMAGE } from '../lib/images';

interface Props {
  lang: Lang;
  /** Dead-end pages (order confirmation) that must stay out of search results. */
  noindex?: boolean;
}

const { lang, noindex = false } = Astro.props;
const tr = t(lang);

const SITE_URL = 'https://www.lesfruitsdebesignan.com';
// Cropped to the 1200×630 the og:image:width/height tags below actually declare.
const ogImage = cloudinary(
  'https://res.cloudinary.com/dgkrgabdc/image/upload/v1759491963/IMG_5966_t9wfap.jpg',
  OG_IMAGE,
);
const canonicalUrl = `${SITE_URL}${tr.layout.canonicalPath}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Les Fruits de Bésignan — GAEC du vieux château",
  "description": tr.layout.description,
  "url": SITE_URL,
  "email": "gaecduvieuxchateau@gmail.com",
  "telephone": farmContact.phoneE164,
  // The farm sells year-round, so one 8am–7pm span covers every day. This is what
  // fills the "Opening hours" row of Google's local panel.
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday", "Tuesday", "Wednesday", "Thursday",
      "Friday", "Saturday", "Sunday"
    ],
    "opens": farmContact.opens,
    "closes": farmContact.closes
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Bésignan",
    "addressLocality": "Bésignan",
    "postalCode": "26110",
    "addressRegion": "Drôme",
    "addressCountry": "FR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 44.327,
    "longitude": 5.335
  },
  "sameAs": ["https://www.instagram.com/les_fruits_de_besignan_/"],
};
---
<!doctype html>
<html lang={tr.layout.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{tr.layout.title}</title>
    <meta name="description" content={tr.layout.description} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <link rel="canonical" href={canonicalUrl} />}

    <!-- hreflang pour le SEO bilingue -->
    <link rel="alternate" hreflang="fr" href={SITE_URL + "/"} />
    <link rel="alternate" hreflang="en" href={SITE_URL + "/en/"} />
    <link rel="alternate" hreflang="x-default" href={SITE_URL + "/"} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={tr.layout.ogLocale} />
    <meta property="og:site_name" content="Les Fruits de Bésignan" />
    <meta property="og:title" content={tr.layout.title} />
    <meta property="og:description" content={tr.layout.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Vergers de la ferme Les Fruits de Bésignan dans les Baronnies Provençales" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tr.layout.title} />
    <meta name="twitter:description" content={tr.layout.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.svg" sizes="any" />

    <!-- Fonts are self-hosted (see the @font-face rules in styles/global.css).
         Preloading the two latin subsets the site actually renders means text
         paints without a second round-trip. -->
    <link rel="preload" href="/fonts/noto-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dancing-script-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html, body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
