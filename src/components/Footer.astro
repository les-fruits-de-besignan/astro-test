---
import '../styles/Footer.css';
import type { Lang } from '../locales';
import { t } from '../locales';
import { farmContact } from '../data/contact';
import PhoneIcon from './PhoneIcon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);

// A direct mail with the subject already filled in, rather than a link to a
// /professionnels page that does not exist yet. Swap the href for that page's
// path once it is written — the copy here needs no change.
const proMailto = `mailto:${farmContact.email}?subject=${encodeURIComponent(tr.footer.proMailSubject)}`;
---
<footer class="footer">
  <div class="container">
    <p class="footer-signoff">{tr.footer.signoff}</p>
    <p class="footer-phone">
      <a
        href={farmContact.phoneHref}
        aria-label={`${tr.contact.phoneAriaLabel} ${farmContact.phone}`}
      >
        <PhoneIcon />
        {farmContact.phone}
      </a>
    </p>
    <p class="footer-pro">
      <span class="footer-pro-question">{tr.footer.proQuestion}</span>
      <a href={proMailto}>{tr.footer.proCta}</a>
    </p>
    <p class="footer-copyright">&copy; {new Date().getFullYear()} Les fruits de Bésignan. {tr.footer.rights}</p>
  </div>
</footer>
