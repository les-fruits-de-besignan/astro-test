---
import '../styles/SalesPoints.css';
import type { Lang } from '../locales';
import { t } from '../locales';
import { salesChannels } from '../data/markets';
import { farmContact } from '../data/contact';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
---
<section id="SalesPoints" class="salesPoints" aria-labelledby="salespoints-title">
  <div class="container">
    <h2 id="salespoints-title" class="section-title">{tr.salesPoints.title}</h2>
    <div class="sales-grid">
      {salesChannels.map((channel) => (
        <div class="sales-cell">
          <h3 class="sales-name">{channel.name[lang]}</h3>
          {channel.details.map((detail) => (
            <p class="sales-detail">{detail[lang]}</p>
          ))}
          {channel.showPhone && (
            <a
              class="sales-phone"
              href={farmContact.phoneHref}
              aria-label={`${tr.contact.phoneAriaLabel} ${farmContact.phone}`}
            >
              <span class="sales-phone-icon" aria-hidden="true">📞</span>
              {farmContact.phone}
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
